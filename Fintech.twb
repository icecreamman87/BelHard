      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0ciurj80ji6p941a1jt1g0up7h8h].[avg:Calculation_0853285610639361:qk]&quot;' value='Avg. Transactions' />
          <alias key='&quot;[federated.0ciurj80ji6p941a1jt1g0up7h8h].[avg:Calculation_0853285611384834:qk]&quot;' value='Avg. Lifetime value' />
          <alias key='&quot;[federated.0ciurj80ji6p941a1jt1g0up7h8h].[ctd:cc_num:qk]&quot;' value='Audience Size' />
          <alias key='&quot;[federated.0ciurj80ji6p941a1jt1g0up7h8h].[sum:amt:qk]&quot;' value='Spend volume' />
        </aliases>
      </column>
      <column caption='Distance to Merchant' datatype='real' name='[Calculation_0146574847627264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DISTANCE(MAKEPOINT([lat], [long]), MAKEPOINT([merch_lat], [merch_long]), &apos;km&apos;)' />
      </column>
      <column caption='Customer Age' datatype='integer' name='[Calculation_0146574855311361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [dob], [trans_date_trans_time])' />
      </column>
      <column caption='Simulation: Rule Status' datatype='string' name='[Calculation_0146574883901442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [amt] &gt;= [Parameters].[Parameter 1] &#13;&#10;THEN &quot;🛑 Blocked by Rule&quot; &#13;&#10;ELSE &quot;✅ Approved&quot; &#13;&#10;END' />
      </column>
      <column caption='Fraud Rate %' datatype='real' default-format='p0.00%' name='[Calculation_0853285566300160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_fraud] == 1 THEN [amt] ELSE 0 END) / SUM([amt])' />
      </column>
      <column caption='User Frequency' datatype='integer' name='[Calculation_0853285610639361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [cc_num] : COUNT([trans_num])}' />
      </column>
      <column caption='User Monetary' datatype='real' name='[Calculation_0853285611384834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [cc_num] : SUM([amt])}' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_1136958578868224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([cc_num])' />
      </column>
      <column caption='Tooltip Date' datatype='date' default-format='*dd-mmm-yy' name='[Calculation_1292266302078976]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([trans_date_trans_time])' />
      </column>
      <column caption='Age Range Label' datatype='string' name='[Calculation_1292266352214017]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(MIN([Calculation_0146574855311361])/10)*10) + &quot; - &quot; + STR(INT(MIN([Calculation_0146574855311361])/10)*10 + 9) + &quot; years&quot;' />
      </column>
      <column caption='Distance Range Label' datatype='string' name='[Calculation_1292266357637122]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(MIN([Calculation_0146574847627264])/10)*10) + &quot; - &quot; + STR(INT(MIN([Calculation_0146574847627264])/10)*10 + 9) + &quot; km&quot;' />
      </column>
      <column caption='Fraud Amount' datatype='real' name='[Calculation_1292266384646148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_fraud] = 1 THEN [amt] ELSE 0 END' />
      </column>
      <column caption='Moving Avg (14 days)' datatype='real' name='[Calculation_1593257586978816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(COUNT([trans_num]), -14, -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Upper Control Limit' datatype='real' name='[Calculation_1593257587101697]' role='measure' type='quantitative'>
