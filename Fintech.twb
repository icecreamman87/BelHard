    <worksheet name='Distance to Merchant'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Distance from the Customer&apos;s home (10 km bin)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='credit_card_transactions' name='federated.0ciurj80ji6p941a1jt1g0up7h8h' />
          </datasources>
          <datasource-dependencies datasource='federated.0ciurj80ji6p941a1jt1g0up7h8h'>
            <column caption='Distance to Merchant' datatype='real' name='[Calculation_0146574847627264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DISTANCE(MAKEPOINT([lat], [long]), MAKEPOINT([merch_lat], [merch_long]), &apos;km&apos;)' />
            </column>
            <column caption='Customer Age' datatype='integer' name='[Calculation_0146574855311361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [dob], [trans_date_trans_time])' />
            </column>
            <column caption='Fraud Rate %' datatype='real' default-format='p0.00%' name='[Calculation_0853285566300160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_fraud] == 1 THEN [amt] ELSE 0 END) / SUM([amt])' />
            </column>
            <column caption='Distance Range Label' datatype='string' name='[Calculation_1292266357637122]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(INT(MIN([Calculation_0146574847627264])/10)*10) + &quot; - &quot; + STR(INT(MIN([Calculation_0146574847627264])/10)*10 + 9) + &quot; km&quot;' />
            </column>
            <column aggregation='None' caption='Customer Age (bin)' datatype='integer' name='[Customer Age (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='1' formula='[Calculation_0146574855311361]' peg='0' size='10' />
            </column>
            <column aggregation='None' caption='Distance to Merchant (bin)' datatype='integer' name='[Distance to Merchant (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='1' formula='[Calculation_0146574847627264]' peg='0' size='10' />
            </column>
            <column caption='Amt' datatype='real' default-format='c#,##0,,.00M;(#,##0,,.00M)' name='[amt]' role='measure' type='quantitative' />
            <column caption='Dob' datatype='date' name='[dob]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Is Fraud' datatype='integer' name='[is_fraud]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='Legitimate' />
                <alias key='1' value='Fraud' />
              </aliases>
            </column>
            <column aggregation='Avg' caption='Lat' datatype='real' name='[lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
            <column aggregation='Avg' caption='Long' datatype='real' name='[long]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
            <column aggregation='Avg' caption='Merch Lat' datatype='real' name='[merch_lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
            <column caption='Merch Long' datatype='real' name='[merch_long]' role='measure' type='quantitative' />
            <column-instance column='[Distance to Merchant (bin)]' derivation='None' name='[none:Distance to Merchant (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[amt]' derivation='Sum' name='[sum:amt:qk]' pivot='key' type='quantitative' />
            <column caption='Trans Date Trans Time' datatype='datetime' name='[trans_date_trans_time]' role='dimension' type='ordinal' />
